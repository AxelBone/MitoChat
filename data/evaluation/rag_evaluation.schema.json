{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/rag_multisystem_evaluation.schema.json",
  "title": "RAG Multi-System Evaluation Record",
  "description": "Schéma JSON pour représenter une question RAG avec plusieurs évaluations (modèles / retrievers) comparables.",
  "type": "object",

  "required": [
    "question_id",
    "query",
    "ground_truth",
    "type_question",
    "difficulty",
    "profile",
    "source_dataset",
    "chunk_metadata"
  ],

  "properties": {
    "question_id": {
      "type": "string",
      "description": "Identifiant unique de la question (UUID ou hash)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage ISO 8601 de la création de la question."
    },
    "query": {
      "type": "string",
      "description": "Texte de la question posée au système RAG."
    },
    "ground_truth": {
      "type": "string",
      "description": "Réponse de référence correcte et validée."
    },
    "type_question": {
      "type": "string",
      "enum": [
        "faits-directs",
        "synthèse multi-documents",
        "raisonnement causal",
        "comparatif",
        "robustesse",
        "suivi de conversation"
      ],
      "description": "Type de question posée au modèle."
    },
    "categorie_cognitive": {
      "type": ["string", "null"],
      "enum": ["rappel", "compréhension", "application", "analyse", "évaluation", "création"],
      "description": "Catégorie cognitive selon la taxonomie de Bloom (facultative)."
    },
    "difficulty": {
      "type": "string",
      "enum": ["facile", "intermédiaire", "difficile"],
      "description": "Niveau de difficulté de la question."
    },
    "profile": {
      "type": "string",
      "enum": ["patient", "professionnel", "chercheur", "association"],
      "description": "Type d’utilisateur ciblé."
    },
    "status": {
      "type": "string",
      "enum": ["généré", "annoté", "validé"],
      "description": "Statut d’annotation ou de validation de la question."
    },
    "source_dataset": {
      "type": "string",
      "description": "Nom du dataset source (clinvar, genereviews, omim, etc.)."
    },
    "language": {
      "type": "string",
      "default": "fr",
      "description": "Langue de la question et des réponses."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Liste de mots-clés thématiques."
    },

    "chunk_metadata": {
      "type": "object",
      "description": "Métadonnées sur les passages de référence utilisés pour générer la question.",
      "required": ["chunk_ids", "source"],
      "properties": {
        "chunk_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Identifiants des chunks sources."
        },
        "source": { "type": "string", "description": "Nom du corpus source." },
        "doc_name": { "type": ["string", "null"], "description": "Nom du document source." },
        "section": { "type": ["string", "null"], "description": "Section du document source." },
        "page": { "type": ["integer", "null"], "description": "Numéro de page si applicable." },
        "type_support": { "type": ["string", "null"], "description": "Type de contenu (texte, liste, tableau, etc.)." }
      }
    },

    "retrieved_documents": {
      "type": "array",
      "description": "Résultats bruts renvoyés par le retriever avant filtrage contextuel.",
      "items": {
        "type": "object",
        "required": ["retriever", "documents"],
        "properties": {
          "retriever": { "type": "string", "description": "Nom du modèle ou algorithme de retrieval utilisé." },
          "retrieved_at": { "type": ["string", "null"], "format": "date-time" },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["chunk_id", "text"],
              "properties": {
                "chunk_id": { "type": "integer" },
                "source": { "type": ["string", "null"] },
                "doc_name": { "type": ["string", "null"] },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "evaluations": {
      "type": "array",
      "description": "Liste des évaluations RAG effectuées pour cette question (multi-modèles / multi-retrievers).",
      "items": {
        "type": "object",
        "required": ["system_id", "retriever_used", "generated_answer", "evaluation_scores"],
        "properties": {
          "system_id": {
            "type": "string",
            "description": "Nom ou identifiant du modèle génératif (ex: qwen2-72b, llama3-70b)."
          },
          "retriever_used": {
            "type": "string",
            "description": "Nom du retriever utilisé pour cette évaluation."
          },
          "evaluation_id": {
            "type": ["string", "null"],
            "description": "Identifiant unique de l’évaluation (UUID ou hash)."
          },
          "evaluated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Date de l’évaluation."
          },
          "contexts_used": {
            "type": "array",
            "description": "Passages transmis au modèle pour génération (après sélection).",
            "items": {
              "type": "object",
              "required": ["chunk_id", "text"],
              "properties": {
                "chunk_id": { "type": "integer" },
                "source": { "type": ["string", "null"] },
                "doc_name": { "type": ["string", "null"] },
                "text": { "type": "string" }
              }
            }
          },
          "generated_answer": {
            "type": "string",
            "description": "Réponse produite par le modèle sur la base des contextes fournis."
          },
          "evaluation_scores": {
            "type": "object",
            "description": "Scores RAGAs ou équivalents obtenus pour cette évaluation.",
            "properties": {
              "faithfulness": { "type": "number", "minimum": 0, "maximum": 1 },
              "answer_relevance": { "type": "number", "minimum": 0, "maximum": 1 },
              "context_precision": { "type": "number", "minimum": 0, "maximum": 1 },
              "context_recall": { "type": "number", "minimum": 0, "maximum": 1 },
              "score_global": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "evaluation_metadata": {
            "type": "object",
            "description": "Métadonnées de l’évaluation.",
            "properties": {
              "method": { "type": ["string", "null"], "description": "Méthode ou outil d’évaluation (ex: RAGAs v1.2)." },
              "evaluator": { "type": ["string", "null"], "description": "Agent ayant évalué la réponse (auto, humain, LLM...)." },
              "evaluation_status": { "type": ["string", "null"], "enum": ["auto", "human_validated", "to_review"] },
              "feedback": { "type": ["string", "null"], "description": "Commentaire qualitatif sur la réponse générée." }
            }
          }
        }
      }
    }
  }
}
